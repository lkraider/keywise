# Local Zig toolchain and its tarballs, downloaded per machine.
zig/

.zig-cache/
zig-out/
zig-pkg/

# One cache and one prefix per parallel build. scripts/win-build-hash.ps1 and
# ci.yml's cross-compile step give each build its own, so neither reads the
# other's artifacts.
.zig-cache-*/
out-*/
build-*.log
build-*.log.err

# Swift Package Manager build artifacts for macos/.
macos/.build/

# scripts/release-package.sh's output directory.
dist/

# make-icon.swift writes this next to the .icns, to look at.
macos/Icon.icns.preview.png

.DS_Store

# Anything extracted from a profile. Never commit key material.
*.db
logins*.json

# Fixtures under here hold synthetic credentials only, written by real
# Firefox over Marionette. See scripts/test-mkfixtures.py.
!core/testdata/**/*.db
!core/testdata/**/logins.json

# Launch-copy drafts, read before posting and never committed.
launch/
